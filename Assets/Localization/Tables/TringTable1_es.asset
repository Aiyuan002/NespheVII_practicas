    m_Metadata:
      m_Items: []
  - m_Id: 114
    m_Localized: "Escudo con parry integrado: mantenlo pulsado para bloquear los
      ataques de enemigos y clava el timing exacto del golpe para que te devuelva
      su coste de energ\xEDa y potenciar tu siguiente disparo"
    m_Metadata:
      m_Items: []
